<mxfile host="Electron" agent="draw.io" version="26.0.9"><diagram id="IyIDJwVJJFAf" name="Безопасность данных"><mxGraphModel dx="2400" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="IyIDJwVJJFAfAqvbXba5-3" value="Безопасность данных" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1f3b57;strokeColor=#0f2236;strokeWidth=2;fontColor=#ffffff;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="-110" y="-45" width="220" height="90" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-6" value="Публичные данные&lt;br&gt;&lt;span style=&quot;font-size:10px;font-weight:normal;&quot;&gt;можно свободно распространять,&lt;br&gt;раскрытие не вредит компании&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="-440" y="-376" width="220" height="80" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-8" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#333333;strokeWidth=2.5;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-3" target="IyIDJwVJJFAfAqvbXba5-6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-11" value="&lt;b&gt;Каталог объектов недвижимости на витрине продаж&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#555555;&quot;&gt;описания, планировки, фото, цены, статус &quot;свободно/забронировано&quot;; client-mart-estate-app, публикация через Kafka&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="-750" y="-533" width="250" height="95" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-13" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-6" target="IyIDJwVJJFAfAqvbXba5-11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-16" value="&lt;b&gt;Искажение&lt;/b&gt;&lt;br&gt;значительный" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="-1000" y="-545" width="190" height="44" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-17" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#d6b656;strokeWidth=1.5;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-11" target="IyIDJwVJJFAfAqvbXba5-16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-18" value="Цена и характеристики на витрине - основание для бронирования. Ошибка или подмена при публикации через Kafka ведет к спорам о цене, жалобам и репутационному ущербу. Исправляется быстро, поэтому не критический." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="-1460" y="-561" width="420" height="76" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-21" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-16" target="IyIDJwVJJFAfAqvbXba5-18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-24" value="&lt;b&gt;Некачественные данные&lt;/b&gt;&lt;br&gt;значительный" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="-1000" y="-462" width="190" height="44" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-25" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#d6b656;strokeWidth=1.5;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-11" target="IyIDJwVJJFAfAqvbXba5-24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-26" value="Статус объекта ведут несколько систем (estate-app, mart-app, CRM), синхронизация не контролируется системно. Неактуальный статус ведет к двойному бронированию уже проданной квартиры." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="-1460" y="-471" width="420" height="61" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-27" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-24" target="IyIDJwVJJFAfAqvbXba5-26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-28" value="&lt;b&gt;Контент онлайн-туров&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#555555;&quot;&gt;3D-модели и панорамы квартир; client-tour-app, client-tour-db&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="-750" y="-354" width="250" height="65" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-29" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-6" target="IyIDJwVJJFAfAqvbXba5-28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-32" value="&lt;b&gt;Потеря&lt;/b&gt;&lt;br&gt;незначительный" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="-1000" y="-381" width="190" height="44" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-34" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#82b366;strokeWidth=1.5;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-28" target="IyIDJwVJJFAfAqvbXba5-32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-36" value="Контент восстанавливается из резервных копий client-tour-db и исходников. Пока тур недоступен, клиент может осмотреть объект офлайн." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="-1460" y="-382" width="420" height="46" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-39" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-32" target="IyIDJwVJJFAfAqvbXba5-36"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-42" value="&lt;b&gt;Обесценивание&lt;/b&gt;&lt;br&gt;незначительный" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="-1000" y="-314" width="190" height="44" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-43" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#82b366;strokeWidth=1.5;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-28" target="IyIDJwVJJFAfAqvbXba5-42"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-46" value="Если тур не обновлять после изменений проекта (отделка, планировка), клиент видит не то, что покупает. Решение о покупке все равно принимается по документам сделки, поэтому ущерб небольшой." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="-1460" y="-322" width="420" height="61" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-49" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-42" target="IyIDJwVJJFAfAqvbXba5-46"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-50" value="&lt;b&gt;Публичная информация о компании и ЖК&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#555555;&quot;&gt;новости, ход строительства, проектные декларации (публикуются по 214-ФЗ)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="-750" y="-205" width="250" height="65" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-53" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-6" target="IyIDJwVJJFAfAqvbXba5-50"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-56" value="&lt;b&gt;Искажение&lt;/b&gt;&lt;br&gt;значительный" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="-1000" y="-232" width="190" height="44" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-59" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#d6b656;strokeWidth=1.5;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-50" target="IyIDJwVJJFAfAqvbXba5-56"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-61" value="Проектная декларация обязательна по 214-ФЗ. Неверные сведения в ней - нарушение закона и введение покупателей в заблуждение." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="-1460" y="-233" width="420" height="46" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-64" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-56" target="IyIDJwVJJFAfAqvbXba5-61"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-65" value="&lt;b&gt;Утечка&lt;/b&gt;&lt;br&gt;незначительный" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="-1000" y="-164" width="190" height="44" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-68" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#82b366;strokeWidth=1.5;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-50" target="IyIDJwVJJFAfAqvbXba5-65"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-71" value="Данные изначально открыты, их раскрытие не причиняет ущерба. Риск есть только при преждевременной публикации, но до релиза это уже внутренние данные." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="-1460" y="-173" width="420" height="61" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-73" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-65" target="IyIDJwVJJFAfAqvbXba5-71"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-76" value="Внутренние данные&lt;br&gt;&lt;span style=&quot;font-size:10px;font-weight:normal;&quot;&gt;только для сотрудников&lt;br&gt;и пользователей сервисов&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="-440" y="214" width="220" height="80" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-77" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#333333;strokeWidth=2.5;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-3" target="IyIDJwVJJFAfAqvbXba5-76"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-79" value="&lt;b&gt;Данные о текущем и капитальном ремонте&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#555555;&quot;&gt;планы работ, история работ, подрядчики; tenant-core-app, tenant-core-db, видны собственникам в приложении&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="-750" y="-24" width="250" height="80" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-81" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-76" target="IyIDJwVJJFAfAqvbXba5-79"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-82" value="&lt;b&gt;Некачественные данные&lt;/b&gt;&lt;br&gt;значительный" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="-1000" y="-44" width="190" height="44" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-85" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#d6b656;strokeWidth=1.5;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-79" target="IyIDJwVJJFAfAqvbXba5-82"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-86" value="Данные приходят от управляющих компаний без контроля качества. Неверные сроки работ в приложении вызывают жалобы собственников и рост обращений в УК." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="-1460" y="-52" width="420" height="61" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-89" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-82" target="IyIDJwVJJFAfAqvbXba5-86"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-91" value="&lt;b&gt;Потеря&lt;/b&gt;&lt;br&gt;значительный" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="-1000" y="32" width="190" height="44" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-93" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#d6b656;strokeWidth=1.5;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-79" target="IyIDJwVJJFAfAqvbXba5-91"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-95" value="История капремонта нужна для отчетов перед собственниками и жилищной инспекцией, восстановить ее из других источников сложно. Резервное копирование БД есть, поэтому не критический." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="-1460" y="23" width="420" height="61" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-98" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-91" target="IyIDJwVJJFAfAqvbXba5-95"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-99" value="&lt;b&gt;Объявления и информация УК для жильцов&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#555555;&quot;&gt;отключения, собрания, новости дома; приходят через API партнеров&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="-750" y="148" width="250" height="65" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-100" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-76" target="IyIDJwVJJFAfAqvbXba5-99"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-102" value="&lt;b&gt;Искажение&lt;/b&gt;&lt;br&gt;критический" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="-1000" y="128" width="190" height="44" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-104" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#b85450;strokeWidth=1.5;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-99" target="IyIDJwVJJFAfAqvbXba5-102"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-106" value="В API партнеров нет разграничения по УК: партнер одной УК может изменить данные другой. Ложное объявление в официальном приложении (например, &quot;оплатите по новым реквизитам&quot;) сразу видят все жильцы дома и доверяют ему." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="-1460" y="112" width="420" height="76" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-107" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-102" target="IyIDJwVJJFAfAqvbXba5-106"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-110" value="&lt;b&gt;Утечка&lt;/b&gt;&lt;br&gt;незначительный" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="-1000" y="203" width="190" height="44" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-112" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#82b366;strokeWidth=1.5;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-99" target="IyIDJwVJJFAfAqvbXba5-110"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-114" value="Объявления адресованы всем жильцам дома и не содержат персональных данных. Раскрытие посторонним почти не вредит." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="-1460" y="202" width="420" height="46" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-115" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-110" target="IyIDJwVJJFAfAqvbXba5-114"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-117" value="&lt;b&gt;Агрегированная аналитика и BI-отчетность&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#555555;&quot;&gt;витрины и отчеты по продажам, спросу, загрузке; Greenplum, BI&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="-750" y="296" width="250" height="80" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-119" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-76" target="IyIDJwVJJFAfAqvbXba5-117"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-121" value="&lt;b&gt;Некачественные данные&lt;/b&gt;&lt;br&gt;критический" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="-1000" y="284" width="190" height="44" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-123" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#b85450;strokeWidth=1.5;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-117" target="IyIDJwVJJFAfAqvbXba5-121"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-125" value="В хранилище сырые данные идут из 5 БД без единого идентификатора клиента и мастер-данных. Дубли и рассогласования искажают отчеты и блокируют ключевую цель компании - продукты на BI/ML/AI." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="-1460" y="276" width="420" height="61" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-127" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-121" target="IyIDJwVJJFAfAqvbXba5-125"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-129" value="&lt;b&gt;Утечка&lt;/b&gt;&lt;br&gt;значительный" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="-1000" y="352" width="190" height="44" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-131" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#d6b656;strokeWidth=1.5;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-117" target="IyIDJwVJJFAfAqvbXba5-129"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-133" value="Отчеты показывают объемы продаж и спрос по ЖК. Для конкурентов это ценно, но персональных данных в агрегатах нет." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="-1460" y="351" width="420" height="46" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-134" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-129" target="IyIDJwVJJFAfAqvbXba5-133"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-135" value="&lt;b&gt;Техническая документация и конфигурации&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#555555;&quot;&gt;архитектура, схемы интеграций, контракты API, настройки систем, системные логи&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="-750" y="446" width="250" height="95" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-137" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-76" target="IyIDJwVJJFAfAqvbXba5-135"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-139" value="&lt;b&gt;Утечка&lt;/b&gt;&lt;br&gt;значительный" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="-1000" y="434" width="190" height="44" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-141" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#d6b656;strokeWidth=1.5;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-135" target="IyIDJwVJJFAfAqvbXba5-139"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-143" value="Схемы и контракты API упрощают атаку: злоумышленник сразу видит точки входа, включая API партнеров, где уже есть проблемы с авторизацией." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="-1460" y="425" width="420" height="61" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-146" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-139" target="IyIDJwVJJFAfAqvbXba5-143"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-149" value="&lt;b&gt;Обесценивание&lt;/b&gt;&lt;br&gt;значительный" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="-1000" y="508" width="190" height="44" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-152" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#d6b656;strokeWidth=1.5;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-135" target="IyIDJwVJJFAfAqvbXba5-149"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-153" value="После смены руководителей команд изменения перестали доходить до специалиста по ИБ. Документация не отражает реальный ландшафт и теряет ценность для аудита и разбора инцидентов." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="-1460" y="500" width="420" height="61" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-155" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-149" target="IyIDJwVJJFAfAqvbXba5-153"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-158" value="Конфиденциальные данные&lt;br&gt;&lt;span style=&quot;font-size:10px;font-weight:normal;&quot;&gt;ПДн, финансовая информация,&lt;br&gt;коммерческая тайна&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="220" y="-376" width="220" height="80" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-160" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#333333;strokeWidth=2.5;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-3" target="IyIDJwVJJFAfAqvbXba5-158"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-163" value="&lt;b&gt;Персональные данные клиентов&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#555555;&quot;&gt;ФИО, телефон, email при регистрации и бронировании; витрина продаж, auth-service-1, client-crm-app, crm-db&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="500" y="-697" width="250" height="80" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-166" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-158" target="IyIDJwVJJFAfAqvbXba5-163"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-168" value="&lt;b&gt;Утечка&lt;/b&gt;&lt;br&gt;критический" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="-716" width="190" height="44" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-169" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#b85450;strokeWidth=1.5;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-163" target="IyIDJwVJJFAfAqvbXba5-168"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-172" value="ПДн по 152-ФЗ. Штраф за утечку - до 15 млн руб., за повторную - оборотный, 1-3% выручки. Копии лежат в нескольких системах (Keycloak, CRM, ElasticSearch, хранилище). После утечки у конкурента репутационный ущерб для компании особенно велик." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1040" y="-732" width="420" height="76" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-174" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-168" target="IyIDJwVJJFAfAqvbXba5-172"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-175" value="&lt;b&gt;Некачественные данные&lt;/b&gt;&lt;br&gt;критический" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="-634" width="190" height="44" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-176" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#b85450;strokeWidth=1.5;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-163" target="IyIDJwVJJFAfAqvbXba5-175"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-178" value="Клиента регистрируют в нескольких точках без координации, появляются дубли и рассогласованные записи. Вероятная причина жалоб: в личном кабинете показываются чужие ФИО, а это уже утечка ПДн." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1040" y="-642" width="420" height="61" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-181" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-175" target="IyIDJwVJJFAfAqvbXba5-178"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-183" value="&lt;b&gt;Расширенная анкета и документы онлайн-сделки&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#555555;&quot;&gt;паспорт, СНИЛС, ИНН, семейное положение, ипотека, договор; client-mart-app, client-mart-db, СМЭВ&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="500" y="-533" width="250" height="95" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-184" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-158" target="IyIDJwVJJFAfAqvbXba5-183"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-185" value="&lt;b&gt;Утечка&lt;/b&gt;&lt;br&gt;критический" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="-545" width="190" height="44" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-186" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#b85450;strokeWidth=1.5;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-183" target="IyIDJwVJJFAfAqvbXba5-185"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-188" value="Полный набор ПДн, достаточный для мошенничества, в том числе с недвижимостью. Нарушение 152-ФЗ и прямой ущерб клиентам на крупные суммы." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1040" y="-554" width="420" height="61" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-189" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-185" target="IyIDJwVJJFAfAqvbXba5-188"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-190" value="&lt;b&gt;Искажение&lt;/b&gt;&lt;br&gt;критический" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="-470" width="190" height="44" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-193" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#b85450;strokeWidth=1.5;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-183" target="IyIDJwVJJFAfAqvbXba5-190"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-196" value="Данные уходят в госорганы через СМЭВ. Ошибка или подмена данных в документах ведет к отказу в регистрации, срыву или оспариванию сделки." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1040" y="-478" width="420" height="61" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-199" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-190" target="IyIDJwVJJFAfAqvbXba5-196"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-201" value="&lt;b&gt;ПДн собственников и лицевые счета ЖКУ&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#555555;&quot;&gt;ФИО, адрес квартиры, проживающие, начисления, задолженность; CRM ЖКУ, crm-tenant-db, tenant-core-db, API УК&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="500" y="-362" width="250" height="80" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-203" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-158" target="IyIDJwVJJFAfAqvbXba5-201"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-206" value="&lt;b&gt;Утечка&lt;/b&gt;&lt;br&gt;критический" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="-381" width="190" height="44" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-208" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#b85450;strokeWidth=1.5;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-201" target="IyIDJwVJJFAfAqvbXba5-206"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-211" value="Контракты API партнеров содержат избыточные ПДн, а партнер одной УК видит данные клиентов другой. Связка &quot;ФИО + адрес + долг&quot; опасна для жильцов и ведет к штрафам по 152-ФЗ." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1040" y="-390" width="420" height="61" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-214" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-206" target="IyIDJwVJJFAfAqvbXba5-211"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-217" value="&lt;b&gt;Искажение&lt;/b&gt;&lt;br&gt;значительный" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="-306" width="190" height="44" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-219" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#d6b656;strokeWidth=1.5;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-201" target="IyIDJwVJJFAfAqvbXba5-217"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-221" value="Партнер может изменить данные чужих клиентов: неверные начисления и конфликты с жильцами. Данные можно восстановить из учета УК, поэтому не критический." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1040" y="-314" width="420" height="61" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-223" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-217" target="IyIDJwVJJFAfAqvbXba5-221"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-226" value="&lt;b&gt;Сырые данные в корпоративном хранилище&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#555555;&quot;&gt;CDC-копии всех продуктовых БД; Хранилище данных (Greenplum), DWH (S3)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="500" y="-190" width="250" height="65" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-227" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-158" target="IyIDJwVJJFAfAqvbXba5-226"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-230" value="&lt;b&gt;Утечка&lt;/b&gt;&lt;br&gt;критический" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="-217" width="190" height="44" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-233" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#b85450;strokeWidth=1.5;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-226" target="IyIDJwVJJFAfAqvbXba5-230"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-236" value="В одном месте собраны ПДн всех клиентов и собственников без маскирования. Со стороны систем обработки данных нет ограничений доступа, доступ есть у бизнес-аналитиков и BI-аналитиков." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1040" y="-226" width="420" height="61" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-239" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-230" target="IyIDJwVJJFAfAqvbXba5-236"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-242" value="&lt;b&gt;Обесценивание&lt;/b&gt;&lt;br&gt;значительный" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="-142" width="190" height="44" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-245" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#d6b656;strokeWidth=1.5;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-226" target="IyIDJwVJJFAfAqvbXba5-242"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-247" value="Без каталога данных, владельцев и обезличивания данные нельзя законно и надежно использовать для BI/ML/AI. Накопленные данные &quot;не работают&quot;, вложения в хранилище не окупаются." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1040" y="-150" width="420" height="61" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-250" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-242" target="IyIDJwVJJFAfAqvbXba5-247"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-252" value="&lt;b&gt;Финансовые и коммерческие данные компании&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#555555;&quot;&gt;бухгалтерский учет, себестоимость, условия договоров с партнерами и подрядчиками; accountant-service-1&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="500" y="-48" width="250" height="95" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-254" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-158" target="IyIDJwVJJFAfAqvbXba5-252"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-257" value="&lt;b&gt;Утечка&lt;/b&gt;&lt;br&gt;значительный" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="-60" width="190" height="44" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-258" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#d6b656;strokeWidth=1.5;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-252" target="IyIDJwVJJFAfAqvbXba5-257"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-261" value="Раскрывает конкурентам маржу и условия договоров. Круг доступа ограничен финансовым доменом и отдельным AD, поэтому не критический." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1040" y="-62" width="420" height="46" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-263" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-257" target="IyIDJwVJJFAfAqvbXba5-261"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-266" value="&lt;b&gt;Потеря&lt;/b&gt;&lt;br&gt;значительный" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="7" width="190" height="44" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-268" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#d6b656;strokeWidth=1.5;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-252" target="IyIDJwVJJFAfAqvbXba5-266"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-269" value="Учетные данные обязательно хранить по 402-ФЗ, потеря ведет к штрафам и срыву отчетности. Резервные копии есть, но проверка восстановления не подтверждена." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1040" y="-2" width="420" height="61" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-272" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-266" target="IyIDJwVJJFAfAqvbXba5-269"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-274" value="Секретные данные&lt;br&gt;&lt;span style=&quot;font-size:10px;font-weight:normal;&quot;&gt;раскрытие - самые серьезные&lt;br&gt;последствия и нарушение закона&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="220" y="386" width="220" height="80" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-277" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#333333;strokeWidth=2.5;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-3" target="IyIDJwVJJFAfAqvbXba5-274"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-279" value="&lt;b&gt;Учетные данные и секреты&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#555555;&quot;&gt;пароли и сессии в Keycloak (auth-service-1, auth-db-1), учетные записи AD, сервисные учетки, ключи и токены API партнеров, ключи шифрования&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="500" y="140" width="250" height="95" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-282" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#b85450;strokeWidth=2;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-274" target="IyIDJwVJJFAfAqvbXba5-279"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-285" value="&lt;b&gt;Утечка&lt;/b&gt;&lt;br&gt;критический" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="128" width="190" height="44" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-288" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#b85450;strokeWidth=1.5;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-279" target="IyIDJwVJJFAfAqvbXba5-285"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-291" value="Компрометация дает доступ к системам и личным кабинетам от имени легальных пользователей. Секреты партнерских интеграций хранятся без единых политик." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1040" y="120" width="420" height="61" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-293" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-285" target="IyIDJwVJJFAfAqvbXba5-291"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-295" value="&lt;b&gt;Некачественные данные&lt;/b&gt;&lt;br&gt;значительный" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="203" width="190" height="44" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-296" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#d6b656;strokeWidth=1.5;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-279" target="IyIDJwVJJFAfAqvbXba5-295"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-297" value="Учетные записи ведутся в двух AD и Keycloak без единого реестра. Без автоматического отзыва остаются учетки уволенных и лишние права." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1040" y="194" width="420" height="61" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-299" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-295" target="IyIDJwVJJFAfAqvbXba5-297"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-300" value="&lt;b&gt;Платежные данные&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#555555;&quot;&gt;реквизиты карт и счетов, транзакции оплаты ЖКУ, платежи по сделкам; платежная система, tenant-core-app, accountant-service-1&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="500" y="289" width="250" height="95" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-302" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#b85450;strokeWidth=2;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-274" target="IyIDJwVJJFAfAqvbXba5-300"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-304" value="&lt;b&gt;Утечка&lt;/b&gt;&lt;br&gt;критический" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="284" width="190" height="44" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-306" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#b85450;strokeWidth=1.5;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-300" target="IyIDJwVJJFAfAqvbXba5-304"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-309" value="Прямой финансовый ущерб клиентам, нарушение закона и требований к обработке карточных данных." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1040" y="284" width="420" height="46" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-312" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-304" target="IyIDJwVJJFAfAqvbXba5-309"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-314" value="&lt;b&gt;Искажение&lt;/b&gt;&lt;br&gt;критический" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="344" width="190" height="44" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-316" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#b85450;strokeWidth=1.5;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-300" target="IyIDJwVJJFAfAqvbXba5-314"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-319" value="Подмена реквизитов получателя уводит деньги мошенникам. Расхождение платежей с начислениями ведет к ошибочным долгам." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1040" y="344" width="420" height="46" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-320" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-314" target="IyIDJwVJJFAfAqvbXba5-319"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-321" value="&lt;b&gt;Управление &quot;Умным домом&quot;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#555555;&quot;&gt;команды и цифровые ключи замков квартир, права на автоматику подъездов и этажей, журнал открытий&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="500" y="460" width="250" height="80" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-324" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#b85450;strokeWidth=2;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-274" target="IyIDJwVJJFAfAqvbXba5-321"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-326" value="&lt;b&gt;Искажение&lt;/b&gt;&lt;br&gt;критический" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="418" width="190" height="44" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-328" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#b85450;strokeWidth=1.5;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-321" target="IyIDJwVJJFAfAqvbXba5-326"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-330" value="Подмена прав или команд открывает квартиру посторонним. Это угроза жизни и имуществу жильцов." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1040" y="418" width="420" height="46" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-333" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-326" target="IyIDJwVJJFAfAqvbXba5-330"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-334" value="&lt;b&gt;Утечка&lt;/b&gt;&lt;br&gt;критический" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="478" width="190" height="44" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-336" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#b85450;strokeWidth=1.5;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-321" target="IyIDJwVJJFAfAqvbXba5-334"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-338" value="Журнал открытий показывает, когда жильцов нет дома, а ключи дают физический доступ в квартиру." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1040" y="478" width="420" height="46" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-341" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-334" target="IyIDJwVJJFAfAqvbXba5-338"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-343" value="&lt;b&gt;Потеря&lt;/b&gt;&lt;br&gt;значительный" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="538" width="190" height="44" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-344" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#d6b656;strokeWidth=1.5;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-321" target="IyIDJwVJJFAfAqvbXba5-343"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-346" value="Потеря прав и ключей не дает жильцам попасть домой или в подъезд. Нужен аварийный механизм доступа, но угрозы безопасности нет." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1040" y="538" width="420" height="46" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-347" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-343" target="IyIDJwVJJFAfAqvbXba5-346"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-348" value="&lt;b&gt;Ключи электронной подписи и доступ к СМЭВ&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#555555;&quot;&gt;ключи и сертификаты для юридически значимого обмена с госорганами по сделкам&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="500" y="632" width="250" height="80" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-349" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#b85450;strokeWidth=2;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-274" target="IyIDJwVJJFAfAqvbXba5-348"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-352" value="&lt;b&gt;Утечка&lt;/b&gt;&lt;br&gt;критический" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="612" width="190" height="44" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-353" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#b85450;strokeWidth=1.5;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-348" target="IyIDJwVJJFAfAqvbXba5-352"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-355" value="Позволяет подписывать юридически значимые документы и запросы в госорганы от имени компании." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1040" y="612" width="420" height="46" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-356" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-352" target="IyIDJwVJJFAfAqvbXba5-355"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-357" value="&lt;b&gt;Обесценивание&lt;/b&gt;&lt;br&gt;значительный" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="680" width="190" height="44" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-359" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#d6b656;strokeWidth=1.5;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-348" target="IyIDJwVJJFAfAqvbXba5-357"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-360" value="Сертификат ЭП действует ограниченный срок. Без контроля сроков и отзыва ключ теряет юридическую силу, онлайн-сделки останавливаются до перевыпуска." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1040" y="672" width="420" height="61" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-362" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1" source="IyIDJwVJJFAfAqvbXba5-357" target="IyIDJwVJJFAfAqvbXba5-360"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-364" value="PropDevelopment: классификация данных и риски (ISO/IEC 27001/27002)" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="-500" y="-882" width="1000" height="40" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-366" value="Категория данных → данные компании и системы-источники → риск и оценка → обоснование оценки" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="-500" y="-842" width="1000" height="26" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-369" value="Оценка риска:" style="text;html=1;align=right;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="-330" y="-802" width="110" height="30" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-371" value="незначительный" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="-210" y="-802" width="160" height="30" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-374" value="значительный" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="-30" y="-802" width="160" height="30" as="geometry"/></mxCell><mxCell id="IyIDJwVJJFAfAqvbXba5-377" value="критический" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="150" y="-802" width="160" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>