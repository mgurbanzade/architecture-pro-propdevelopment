@startuml c4-context-smart-home
!include <C4/C4_Context>

LAYOUT_TOP_DOWN()
skinparam dpi 150
skinparam wrapWidth 220

title PropDevelopment: контекст сервисов «Умный дом» (интеллектуальный домофон и шлагбаум)

Person(owner, "Собственник", "Жилец ЖК. Через мобильное приложение отвечает на вызовы домофона, открывает дверь и шлагбаум, управляет списком лиц и автомобилей с доступом")
Person(guest, "Гость / посетитель", "Звонит в квартиру через вызывную панель или подъезжает к шлагбауму")
Person(dispatcher, "Диспетчер управляющей компании", "Открывает доступ экстренным и коммунальным службам, разбирает сбои оборудования")

System(prop, "PropDevelopment", "Сервисы ЖКУ: мобильное приложение собственника, сервис «Умный дом» (права доступа, согласия, журнал событий), CRM собственников, аутентификация")

System_Ext(platform, "Платформа «Умный дом» партнера", "Облачная платформа в РФ: видеодомофония, распознавание лиц и номеров автомобилей, управление устройствами, журнал проходов")
System_Ext(devices, "Оборудование на объектах", "Вызывные панели с камерами, электромагнитные замки подъездов, камеры и контроллеры шлагбаумов. Установлено в ЖК, управляется платформой партнера")
System_Ext(push, "Сервисы push-уведомлений", "APNs (iOS) и FCM (Android): доставка входящих вызовов и событий на телефон")
System_Ext(uk, "Системы управляющих компаний", "Данные о домах и квартирах, заявки на обслуживание оборудования")

Rel(owner, prop, "Управляет доступом, открывает дверь и шлагбаум, смотрит журнал", "Мобильное приложение, HTTPS")
Rel(owner, platform, "Видео и голос при вызове, загрузка фото лица после согласия", "WebRTC / HTTPS, одноразовый токен от PropDevelopment")
Rel(guest, devices, "Звонит в квартиру, подъезжает к шлагбауму")
Rel(dispatcher, platform, "Ручное открытие и мониторинг оборудования", "Веб-консоль партнера, SSO + MFA")
Rel(prop, platform, "Синхронизация прав доступа (жильцы, гости, номера авто), команды открытия, токены вызова", "REST, HTTPS, mTLS + OAuth 2.0")
Rel(platform, prop, "События: вызов, проход, распознавание, сбой оборудования", "Webhook, HTTPS, mTLS + подпись HMAC")
Rel(platform, devices, "Управление замками и шлагбаумами, видеопоток", "Защищенный VPN-канал")
Rel(prop, push, "Уведомление о входящем вызове и событиях (без ПДн в тексте)", "HTTPS")
Rel(push, owner, "Push-уведомление")
Rel(prop, uk, "Сведения о домах, заявки на ремонт оборудования", "REST через API-шлюз, OAuth 2.0")

SHOW_LEGEND()
@enduml
