енные регистрационные органы&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;font-size: 11px&quot;&gt;&lt;b&gt;[Software System]&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot; color=&quot;#F0F0F0&quot;&gt;Отвечают за регистрационные действия с объектами недвижимости&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="5" y="585" width="240" height="120" as="geometry"/></mxCell><mxCell id="vMhAxOn2QQtakJ_xbt7w-102" value="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;Поставщик ресурсов ЖКХ&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;font-size: 11px&quot;&gt;&lt;b&gt;[Software System]&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot; color=&quot;#F0F0F0&quot;&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="3505" y="380" width="240" height="120" as="geometry"/></mxCell><mxCell id="vMhAxOn2QQtakJ_xbt7w-105" value="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;Поставщик ресурсов ЖКХ&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;font-size: 11px&quot;&gt;&lt;b&gt;[Software System]&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot; color=&quot;#F0F0F0&quot;&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="3465" y="405" width="240" height="120" as="geometry"/></mxCell><mxCell id="vMhAxOn2QQtakJ_xbt7w-107" value="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;Поставщик ресурсов ЖКХ&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;font-size: 